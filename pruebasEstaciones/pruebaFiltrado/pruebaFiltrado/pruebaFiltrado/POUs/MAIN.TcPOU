<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{cbd6c4bf-6373-4be1-b0b1-5f6d9871d58c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // --------------------------- Sistema principal ---------------------------
    enclaveStart: BOOL;       // Indica si el sistema esta activo
    emergencia: BOOL;         // Señal de emergencia activa
    renudar: BOOL := TRUE;    // Reanudar proceso si se interrumpe

    // --------------------------- Luces del cuadro ---------------------------
    luzStart: BOOL;           // Indicador de Start
    luzStop: BOOL;            // Indicador de Stop
    luzReset: BOOL;           // Indicador de Reset
    luzVerde: BOOL;           // Luz verde del sistema
    luzAmarilla: BOOL;        // Luz amarilla del sistema
    luzRoja: BOOL;            // Luz roja del sistema

    // --------------------------- Cintas ---------------------------
    cintaVision: BOOL;             // Cinta de vision
    cintaRemoveVision: BOOL;       // Cinta de remove de vision
    cintaBascula: BOOL;            // Cinta de bascula
    cintaPostBascula: BOOL;        // Cinta posterior a bascula
    cintaRemoveBascula: BOOL;      // Cinta de remove de bascula
    cintaBasculaPositivo: BOOL;    // Direccion positiva cinta bascula
    cintaBasculaNegativo: BOOL;    // Direccion negativa cinta bascula

    // --------------------------- Sensores y flancos ---------------------------
    flancoAscendenteVision: R_TRIG;       // Flanco ascendente sensor vision
    flancoSalidaVision: F_TRIG;           // Flanco de salida de la cinta de vision
    flancoSensorFinal: F_TRIG;            // Flanco sensor final
    flancAnteriorCilindroVision: F_TRIG;  // Flanco anterior cilindro vision
    flancoCintaDescarte: F_TRIG;          // Flanco cinta de descarte
    flancAnteriorCilindroBascula: F_TRIG; // Flanco anterior cilindro bascula
    flancoCintaDescarteBascula: F_TRIG;   // Flanco cinta de descarte bascula

    // --------------------------- Cilindros ---------------------------
    cilindroVision: BOOL;       // Activacion cilindro vision
    cilindroBascula: BOOL;      // Activacion cilindro bascula

    // --------------------------- Temporizadores ---------------------------
    timerVision: TON;           // Temporizador para vision
    startTimerVision: BOOL;     // Inicio temporizador vision
    timerBascula: TON;          // Temporizador para bascula
    startTimerBascula: BOOL;    // Inicio temporizador bascula

    // --------------------------- Variables de control ---------------------------
    descarteXcolor: BOOL;        // Indica que se descarta por color
    descartando: BOOL;           // Indica que se esta descartando por color
    descratandoXpeso: BOOL;      // Indica que se esta descartando por peso
    descarteXpeso: BOOL;          // Indica que se descarta por peso
    objetoPosicionDescarteV: BOOL; // Objeto colocado para cilindro vision
    objetoPosicionDescarteP: BOOL; // Objeto colocado para cilindro bascula
    sinComparar: BOOL := FALSE;  // Indica que el peso aun no se comparo
    peso: REAL;                  // Peso del objeto
    azul: BOOL;                  // Color azul detectado
    metal: BOOL;                 // Material metal detectado
    verde: BOOL;                 // Color verde detectado

    // --------------------------- Modo de operacion ---------------------------
    modoManual: BOOL;            // Modo manual
    modoAuto: BOOL;              // Modo automatico
	difusoVisionAnt: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ------------------- PASO 1 - Botones cuadro -------------------
luzStart := FALSE;
luzStop := FALSE;
luzReset := FALSE;

IF GVLvars.botonStart AND NOT emergencia THEN
	enclaveStart := TRUE;        // Activar sistema
	cintaVision := TRUE;         // Arranca cinta vision
	luzStart := TRUE; 
	luzVerde := TRUE;            // Luz verde encendida
	luzAmarilla := FALSE;        // Luz amarilla apagada
	luzRoja := FALSE;            // Luz roja apagada
END_IF

IF NOT GVLvars.botonStop AND NOT emergencia THEN
	enclaveStart := FALSE;        // Desactivar sistema
	cintaVision := FALSE;
	cintaRemoveVision := FALSE;
	cintaBascula := FALSE;
	cintaPostBascula := FALSE;
	cintaRemoveBascula := FALSE;
	cilindroVision := FALSE;
	cilindroBascula := FALSE;
	luzStop := TRUE; 
	luzVerde := FALSE;
	luzAmarilla := TRUE;
	luzRoja := FALSE;
END_IF

IF NOT GVLvars.setaEmergencia THEN
	enclaveStart := FALSE;        // Desactivar sistema
	cintaVision := FALSE;
	cintaRemoveVision := FALSE;
	cintaBascula := FALSE;
	cintaPostBascula := FALSE;
	cintaRemoveBascula := FALSE;
	cilindroVision := FALSE;
	cilindroBascula := FALSE;
	luzStop := FALSE;
	luzVerde := FALSE;
	luzAmarilla := FALSE;
	luzRoja := TRUE;             // Luz roja de emergencia
	emergencia := TRUE;
END_IF

IF GVLvars.setaEmergencia AND emergencia THEN
	IF GVLvars.botonReset THEN
		enclaveStart := TRUE;     // Reactivar sistema
		luzStop := FALSE;
		luzVerde := TRUE;
		luzAmarilla := FALSE;
		luzRoja := FALSE;
		emergencia := FALSE;
		luzReset := TRUE;         // Indica reset realizado
		cintaVision := TRUE;
		cintaRemoveVision := TRUE;
		cintaBascula := TRUE;
		cintaPostBascula := TRUE;
		cintaRemoveBascula := TRUE;
	END_IF
END_IF

IF GVLvars.modoManual THEN
	modoManual := TRUE;
	modoAuto := FALSE;
END_IF

IF GVLvars.modoAuto THEN
	modoManual := FALSE;
	modoAuto := TRUE;
END_IF

// ------------------- PASO 2 - Filtro Vision -------------------
IF enclaveStart AND NOT emergencia THEN
	flancoAscendenteVision(CLK:=GVLvars.sDifusoVision);
	IF flancoAscendenteVision.Q THEN
		startTimerVision := TRUE;   // Arranca temporizador
		cintaVision := FALSE;       // Para la cinta
	END_IF
	difusoVisionAnt := GVLvars.sDifusoVision;

	timerVision(IN:=startTimerVision, PT:=T#2S);
	IF timerVision.Q THEN
		startTimerVision := FALSE;
		// Determina si se descarta por color
		IF GVLvars.sVision = 3 OR GVLvars.sVision = 9 THEN
			descarteXcolor := FALSE;   // Azul o metal: no descartar
		ELSE
			descarteXcolor := TRUE;    // Otro color: descartar
		END_IF
		azul := GVLvars.sVision = 3;
		metal := GVLvars.sVision = 9;
		verde := GVLvars.sVision = 6;
		cintaVision := TRUE;           // Reanuda cinta
	END_IF

	IF descarteXcolor AND GVLvars.sCilindroVision THEN
		descartando := TRUE;           // Activar proceso de descarte vision
	END_IF

	flancAnteriorCilindroVision(CLK := GVLvars.sCilindroVision);
	flancoCintaDescarte(CLK := GVLvars.sDifusoRemoveVision);

	IF descartando AND flancAnteriorCilindroVision.Q THEN
		objetoPosicionDescarteV := TRUE; // Objeto en posicion cilindro vision
	END_IF

	IF objetoPosicionDescarteV THEN
		cintaVision := FALSE;
		cilindroVision := TRUE;
		cintaRemoveVision := TRUE;
	END_IF

	flancoSalidaVision(CLK:=GVLvars.sSalidaCintaVision);
	IF GVLvars.sSalidaCintaVision THEN
		cintaVision := FALSE;
		cintaBascula := TRUE;          // Mueve objeto a bascula
	END_IF

	IF flancoCintaDescarte.Q THEN
		cintaVision := TRUE;
		cilindroVision := FALSE;
		descartando := FALSE;
		cintaRemoveVision := FALSE;
		objetoPosicionDescarteV := FALSE;
		IF modoManual THEN
			enclaveStart := FALSE;
		END_IF
	END_IF

// ------------------- PASO 3 - Filtro peso -------------------
	IF GVLvars.sDifusoBascula THEN
		cintaVision := FALSE;
		startTimerBascula := TRUE; // Arranca temporizador bascula
		cintaBascula := FALSE;
	END_IF

	timerBascula(IN:=startTimerBascula, PT:=T#2S);

	IF timerBascula.Q AND sinComparar = FALSE THEN
		startTimerBascula := FALSE;
		peso := GVLvars.pesoBascula;
		cintaBascula := TRUE;
		cintaPostBascula := TRUE;
		sinComparar := TRUE;
	END_IF

	IF peso > 4 THEN
		descarteXpeso := TRUE;
		sinComparar := FALSE;
	ELSE
		descarteXpeso := FALSE;
		sinComparar := FALSE;
	END_IF

	IF descarteXpeso AND GVLvars.sCilindroBascula THEN
		descratandoXpeso := TRUE;
	END_IF

	flancAnteriorCilindroBascula(CLK := GVLvars.sCilindroBascula);
	flancoCintaDescarteBascula(CLK :=GVLvars.sDifusoRemovePeso);

	IF descratandoXpeso AND flancAnteriorCilindroBascula.Q THEN
		objetoPosicionDescarteP := TRUE;
	END_IF

	IF objetoPosicionDescarteP THEN
		cintaBascula := FALSE;
		cintaPostBascula := FALSE;
		cilindroBascula := TRUE;
		cintaRemoveBascula := TRUE;
	END_IF

	flancoSensorFinal(CLK:=GVLvars.sRemoveFinal);
	IF flancoSensorFinal.Q THEN
		cintaPostBascula := FALSE;
		cintaVision := TRUE;
		IF modoManual THEN
			enclaveStart := FALSE;
		END_IF
	END_IF

	IF flancoCintaDescarteBascula.Q THEN
		cilindroBascula := FALSE;
		descratandoXpeso := FALSE;
		descarteXpeso := FALSE;
		cintaRemoveBascula := FALSE;
		objetoPosicionDescarteP := FALSE;
		cintaVision := TRUE;
		IF modoManual THEN
			enclaveStart := FALSE;
		END_IF
	END_IF

ELSE
	cintaVision := FALSE;
	cintaBascula := FALSE;
	cintaPostBascula := FALSE;
END_IF

// ------------------- PASO 4 - Actualizar salidas -------------------
GVLvars.cintaBascula := cintaBascula;
GVLvars.cintaPostBascula := cintaPostBascula;
GVLvars.cintaRemoveBascula := cintaRemoveBascula;
GVLvars.cintaRemoveVision := cintaRemoveVision;
GVLvars.cintaVision := cintaVision;
GVLvars.cilindroBascula := cilindroBascula;
GVLvars.cilindroVision := cilindroVision;
GVLvars.luzAmarilla := luzAmarilla;
GVLvars.luzRoja := luzRoja;
GVLvars.luzVerde := luzVerde;
GVLvars.luzBotonStop := luzStop;
GVLvars.luzBotonStart := luzStart;
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="1393" Count="212" />
      <LineId Id="6" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>