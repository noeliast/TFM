<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{801920e0-6ca6-4611-bcca-80d44a3fd171}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // --------------------------- Sistema principal ---------------------------
    enclaveStart: BOOL;       // Indica si el sistema esta activo
    emergencia: BOOL;         // Senal de emergencia activa

    // --------------------------- Luces del cuadro ---------------------------
    luzVerde: BOOL;           // Luz verde del sistema
    luzAmarilla: BOOL;        // Luz amarilla del sistema
    luzRoja: BOOL;            // Luz roja del sistema
    luzStart: BOOL;           // Indicador de Start
    luzStop: BOOL;            // Indicador de Stop
    luzReset: BOOL;           // Indicador de Reset

    // --------------------------- Cintas ---------------------------
    cintaEntradaMaterial: BOOL;       // Cinta de entrada de material
    cintaInclinadaMaterial: BOOL;     // Cinta inclinada de material
    cintaEntradaPalets: BOOL;         // Cinta de entrada de palets
    cintaSalida: BOOL;                // Cinta de salida de palet cargado
    cintaPaletEntradaEstacion: BOOL;  // Cinta que lleva palet a la estacion

    // --------------------------- Mesa giratoria ---------------------------
    turnMesaGiratoria: BOOL;  // Giro de la mesa rotatoria
    mesaCargada: BOOL;        // Indica si la mesa esta cargada
    girandoMesa: BOOL;        // Indica si la mesa esta girando
    load: BOOL;               // Senal de carga de palet en mesa
    unload: BOOL;             // Senal de descarga de palet en mesa

    // --------------------------- Paletizador ---------------------------
    turnPaletizador: BOOL;    // Giro del paletizador
    pusher: BOOL;             // Cilindro pusher
    turnFlipper: BOOL;        // Giro del flipper (solo salida)
    moveClamper: BOOL;        // Movimiento del clamp (solo salida)
    beltPositive: BOOL;       // Movimiento positivo de cinta
    beltNegative: BOOL;       // Movimiento negativo de cinta (solo salida)
    chainPositive: BOOL;      // Movimiento positivo de cadena
    chainNegative: BOOL;      // Movimiento negativo de cadena (solo salida)
    openPlate: BOOL;          // Abrir plato
    elevatorUp: BOOL;         // Subida de palet
    elevatorDown: BOOL;       // Bajada de palet
    elevatorToLimit: BOOL;    // Mover palet a limite
    PaletListo: BOOL;         // Indica que palet esta listo
    paletizadoListo: BOOL;    // Indica que palet ya esta cargado
    bajandoPalet: BOOL;       // Indica bajada del palet
    saliendo: BOOL;           // Indica salida del palet de la estacion
    MatrizElemLista: BOOL;    // Indica que la matriz de elementos esta lista

    // --------------------------- Sensores y flancos ---------------------------
    flancoEntradaMaterial: F_TRIG;   // Flanco de entrada de material
    flancoEntradaPalets: F_TRIG;     // Flanco de entrada de palets
    flancoPusher: R_TRIG;            // Flanco del pusher
    flancoPlato: R_TRIG;             // Flanco de plato abierto
    flancoPostPaletizado: F_TRIG;    // Flanco de post paletizado
    flancoBasePalet: R_TRIG;         // Flanco de base de palet

    // --------------------------- Temporizadores ---------------------------
    timerOpenPlate: TON;    // Temporizador de apertura del plato
    timerVector: TON;       // Temporizador para control de vector
    timerAbrirPusher: TON;  // Temporizador para pusher
    timerBajadaPalet: TON;  // Temporizador para bajada del palet
    timerSubidaPalet: TON;  // Temporizador para subida del palet

    // --------------------------- Control interno ---------------------------
    contadorVector: INT;        // Contador de elementos antes del pusher
    startTimerVector: BOOL;     // Inicia temporizador de vector
    esperaPusher: BOOL;         // Indica espera antes de activar pusher
    recogerPusher: BOOL;        // Control de recogida con pusher
    numProductosCompletos: INT; // Contador de productos completados
    modoManual: BOOL;           // Modo manual
    modoAuto: BOOL;             // Modo automatico
	clamp : bool;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Inicializacion de luces
luzStart := FALSE;
luzStop := FALSE;
luzReset := FALSE;

// --------------------------- Control Start ---------------------------
IF GVLvars.botonStart AND NOT emergencia THEN
	enclaveStart := TRUE;                 // Activar el sistema
	cintaEntradaMaterial := TRUE;         // Arranca cinta de material
	cintaEntradaPalets := TRUE;           // Arranca cinta de palets
	turnPaletizador := TRUE;              // Activa giro de paletizador
	luzStart := TRUE;                     // Encender indicador Start
	luzVerde := TRUE;                     // Luz verde encendida
	luzAmarilla := FALSE;                 // Luz amarilla apagada
	luzRoja := FALSE;                     // Luz roja apagada
END_IF

// --------------------------- Control Stop ---------------------------
IF NOT GVLvars.botonStop AND NOT emergencia THEN
	enclaveStart := FALSE;                // Desactivar sistema
	luzStop := TRUE;                      // Encender luz Stop
	luzVerde := FALSE;                    // Apagar luz verde
	luzAmarilla := TRUE;                  // Encender luz amarilla
	luzRoja := FALSE;                     // Luz roja apagada
	cintaEntradaMaterial := FALSE;
	cintaInclinadaMaterial := FALSE;
	cintaEntradaPalets := FALSE;
	cintaPaletEntradaEstacion := FALSE;
	cintaSalida := FALSE;
	turnPaletizador := FALSE;
	turnMesaGiratoria := FALSE;
	load := FALSE;
	unload := FALSE;
END_IF

// --------------------------- Emergencia ---------------------------
IF NOT GVLvars.seta THEN
	enclaveStart := FALSE;                // Desactivar sistema
	luzVerde := FALSE;
	luzAmarilla := FALSE;
	luzRoja := TRUE;                      // Luz roja encendida
	emergencia := TRUE;                   // Activar estado emergencia
	cintaEntradaMaterial := FALSE;
	cintaInclinadaMaterial := FALSE;
	cintaEntradaPalets := FALSE;
	cintaPaletEntradaEstacion := FALSE;
	cintaSalida := FALSE;
	turnPaletizador := FALSE;
	load := FALSE;
	unload := FALSE;
END_IF

// --------------------------- Reset emergencia ---------------------------
IF GVLvars.seta AND emergencia THEN
	IF GVLvars.botonReset THEN
		enclaveStart := TRUE;
                 // Restablece sistema despues de emergencia
		luzVerde := TRUE;
		luzAmarilla := FALSE;
		luzRoja := FALSE;
		emergencia := FALSE;
		cintaEntradaMaterial := TRUE;
		cintaInclinadaMaterial := TRUE;
		cintaEntradaPalets := TRUE;
		cintaPaletEntradaEstacion := TRUE;
		cintaSalida := TRUE;
		turnPaletizador := TRUE;
	END_IF
END_IF

// --------------------------- Modo manual / automatico ---------------------------
IF GVLvars.modoManual THEN
	modoManual := TRUE;
	modoAuto := FALSE;
END_IF

IF GVLvars.modoAuto THEN
	modoManual := FALSE;
	modoAuto := TRUE;
END_IF

// --------------------------- Material - Parte Superior ---------------------------
IF enclaveStart AND NOT emergencia THEN
	// Control de cinta inclinada
	IF GVLvars.sDifusoCintaMaterial THEN
		cintaInclinadaMaterial := TRUE;
	END_IF

	// Detecta llegada de material al plato
	flancoEntradaMaterial(CLK:=GVLvars.sEntradaPaletizadorMaterial);
	IF flancoEntradaMaterial.Q THEN
		beltPositive := TRUE;                // Arrancar cinta del paletizador
		contadorVector := contadorVector + 1; // Incrementa contador de elementos
	END_IF

	// Activar pusher cuando hay suficientes elementos
	IF contadorVector >= 2 AND paletListo THEN
		startTimerVector := TRUE;
	END_IF

	// Temporizador para verificar posicion final de elementos
	timerVector(IN := startTimerVector, PT:=T#2S);
	IF timerVector.Q THEN
		esperaPusher := TRUE;
		startTimerVector := FALSE;
		cintaEntradaMaterial := FALSE;
		cintaInclinadaMaterial := FALSE;
	END_IF

	// Accionamiento del pusher
	flancoPusher(CLK:=GVLvars.pusherLimit);
	IF esperaPusher THEN
		beltPositive := FALSE;
		pusher := TRUE;

		IF flancoPusher.Q THEN
			pusher := FALSE;
			clamp := TRUE;                  // Activar clamp
			contadorVector := 0;
			esperaPusher := FALSE;
			MatrizElemLista := TRUE;        // Elementos listos en la matriz
		END_IF
	END_IF
END_IF

// --------------------------- Palets - Parte Inferior ---------------------------
IF enclaveStart AND NOT emergencia THEN
	flancoEntradaPalets(CLK:=GVLvars.sEntradaMesaRotation);
	IF flancoEntradaPalets.Q THEN
		cintaEntradaPalets := FALSE;
	END_IF

	IF GVLvars.sEntradaMesaRotation THEN
		load := TRUE;          // Cargar palet en mesa
		mesaCargada := TRUE;   // Marca que mesa esta cargada
	END_IF

	IF girandoMesa THEN 
		turnMesaGiratoria := TRUE;    // Girar mesa
	END_IF

	// Control de rotacion de mesa
	IF GVLvars.frontLimit AND NOT GVLvars.maximunRotation THEN
		load := FALSE;
		turnMesaGiratoria := TRUE;
		girandoMesa := TRUE;
	ELSIF GVLvars.frontLimit AND GVLvars.maximunRotation THEN
		load := TRUE;
		cintaPaletEntradaEstacion := TRUE;
	ELSIF NOT GVLvars.frontLimit AND GVLvars.maximunRotation AND GVLvars.sSalidaMesaRotacion THEN
		turnMesaGiratoria := FALSE;
		mesaCargada := FALSE;
		load := FALSE;
		girandoMesa := FALSE;
	END_IF

	// Entrada de palet a estacion
	flancoEntradaPalets(CLK:=GVLvars.sEntradaPaletEnEstacion);
	IF flancoEntradaPalets.Q THEN
		chainPositive := TRUE;
		saliendo := FALSE;
	END_IF

	// Subida de palet
	IF GVLvars.elevatorFrontLimit AND PaletListo = FALSE AND saliendo = FALSE THEN
		chainPositive := FALSE;
		elevatorToLimit := TRUE;
		elevatorUp := TRUE;
		PaletListo := TRUE;
		elevatorDown := FALSE;
		openPlate := FALSE; // mientras no este arriba no abrir plato
	END_IF

	// Abrir plato cuando palet y materiales listos
	flancoPlato(CLK:=GVLvars.plateLimit);
	IF MatrizElemLista AND PaletListo THEN
		openPlate := TRUE;
		IF flancoPlato.Q THEN
			elevatorToLimit := TRUE;
			elevatorUp := FALSE;
			elevatorDown := TRUE;
			paletizadoListo := TRUE;
			openPlate := FALSE;
			MatrizElemLista := FALSE;
		END_IF
	END_IF

	// Bajada del palet
	flancoBasePalet(CLK:=GVLvars.sBasePalet);
	IF flancoBasePalet.Q THEN
		chainPositive := TRUE;
		cintaSalida := TRUE;
		elevatorToLimit := FALSE;
		elevatorUp := FALSE;
		elevatorDown := FALSE;
	END_IF

	// Post paletizado
	flancoPostPaletizado(CLK:=GVLvars.sPostPaletizado);
	IF flancoPostPaletizado.CLK THEN
		chainPositive := FALSE;
		paletizadoListo := FALSE;
		PaletListo := FALSE;
		openPlate := FALSE;
		saliendo := TRUE;
		cintaEntradaMaterial := TRUE;
		cintaEntradaPalets := TRUE;
		numProductosCompletos := numProductosCompletos + 1;
		IF modoManual THEN
			enclaveStart := FALSE;
		END_IF
	END_IF
ELSE
	// Si el enclave no esta activo
	cintaEntradaMaterial := FALSE;
	cintaInclinadaMaterial := FALSE;
	cintaEntradaPalets := FALSE;
	cintaPaletEntradaEstacion := FALSE;
	cintaSalida := FALSE;
END_IF

// --------------------------- Actualizar salidas ---------------------------
GVLvars.luzVerde := luzVerde;
GVLvars.luzRoja := luzRoja;
GVLvars.luzAmarilla := luzAmarilla;
GVLvars.cintaEntradaMaterial := cintaEntradaMaterial;
GVLvars.cintaInclinadaMaterial := cintaInclinadaMaterial;
GVLvars.cintaEntradaPalets := cintaEntradaPalets;
GVLvars.cintaSalida := cintaSalida;
GVLvars.cintaPaletEntradaEstacion := cintaPaletEntradaEstacion;
GVLvars.turnMesaGiratoria := turnMesaGiratoria;
GVLvars.load := load;
GVLvars.unload := unload;
GVLvars.pusher := pusher;
GVLvars.turnFlipper := turnFlipper;
GVLvars.moveClamper := moveClamper;
GVLvars.beltPositive := beltPositive;
GVLvars.beltNegative := beltNegative;
GVLvars.chainPositive := chainPositive;
GVLvars.chainNegative := chainNegative;
GVLvars.OpenPlate := openPlate;
GVLvars.elevatorUp := elevatorUp;
GVLvars.elevatorDown := elevatorDown;
GVLvars.elevatorToLimit := elevatorToLimit;
GVLvars.numProductosCompletos := numProductosCompletos;
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="3320" Count="244" />
      <LineId Id="32" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>