<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{d409ff99-3b5d-4bd9-9b04-f975b0e40891}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    //------------------------------------------
    // Control general del sistema
    //------------------------------------------
    sistemaActivo : BOOL; // Flag de activacion del sistema
    emergencia    : BOOL; // Estado de emergencia
    modoManual    : BOOL; // Sistema en modo manual
    modoAuto      : BOOL; // Sistema en modo automatico

    //------------------------------------------
    // Cintas y sensores
    //------------------------------------------
    cintaBase     : BOOL; // Estado de cinta base
    cintaTapa     : BOOL; // Estado de cinta tapa
    baseOK        : BOOL; // Base posicionada correctamente
    tapaOK        : BOOL; // Tapa posicionada correctamente

    //------------------------------------------
    // Pick & Place - maquina de estados
    //------------------------------------------
    EstadoPickPlace       : INT; // Estado actual de la secuencia Pick & Place
    timerMovimiento       : TON; // Timer para movimientos de la maquina
    flancoTapa            : F_TRIG; // Flanco de sensor de tapa
    flancoBase            : F_TRIG; // Flanco de sensor de base
    flancoPostSellado     : F_TRIG; // Flanco de sensor post-sellado

    //------------------------------------------
    // Luces del cuadro
    //------------------------------------------
    luzVerde    : BOOL; // Luz verde de sistema activo
    luzNaranja  : BOOL; // Luz naranja de sistema en espera o parado
    luzRojo     : BOOL; // Luz roja de emergencia
    luzStop     : BOOL; // Luz de boton stop
    luzStart    : BOOL; // Luz de boton start
    luzReset    : BOOL; // Luz de boton reset

    //------------------------------------------
    // Variables de control Pick & Place
    //------------------------------------------
    bajarSinObjeto  : BOOL; // Indica bajada sin objeto
    bajarConObjeto  : BOOL; // Indica bajada con objeto
    comiezaProceso  : BOOL; // Indica que la secuencia esta en proceso
    objetoSujeto    : BOOL; // Indica que el objeto esta agarrado
	ProductoFinal: BOOL;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[//------------------------------------------ Logica Botones ------------------------------------------

// Reinicio de indicadores luminosos de los botones
luzStop := FALSE;
luzStart := FALSE;
luzReset := FALSE;

// Start: activa sistema si no hay emergencia
IF GVLvars.botonStart AND NOT emergencia THEN
    sistemaActivo := TRUE;
    luzVerde := TRUE;
    luzNaranja := FALSE;
    luzRojo := FALSE;
    luzStop := FALSE;
    luzStart := TRUE;
END_IF

// Stop: desactiva sistema si no hay emergencia
IF NOT GVLvars.botonStop AND NOT emergencia THEN
    luzReset := TRUE;
    sistemaActivo := FALSE;
    cintaBase := FALSE;
    cintaTapa := FALSE;
    luzVerde := FALSE;
    luzNaranja := TRUE;
    luzRojo := FALSE;
END_IF

// Emergencia: detiene todo y enciende luz roja
IF NOT GVLvars.seta THEN
    sistemaActivo := FALSE;
    cintaBase := FALSE;
    cintaTapa := FALSE;
    luzVerde := FALSE;
    luzNaranja := FALSE;
    luzRojo := TRUE;
    emergencia := TRUE;
END_IF

// Reset despues de emergencia
IF GVLvars.seta AND emergencia THEN
    IF GVLvars.botonReset THEN
        sistemaActivo := TRUE;
        luzVerde := TRUE;
        luzNaranja := FALSE;
        luzRojo := FALSE;
        luzStop := FALSE;
        luzStart := FALSE;
        luzReset := TRUE;
        emergencia := FALSE;
    END_IF
END_IF

// Seleccion de modo manual o automatico
IF GVLvars.modoManual THEN 
    modoManual := TRUE;
    modoAuto := FALSE;
END_IF

IF GVLvars.modoAuto THEN
    modoManual := FALSE;
    modoAuto := TRUE;
END_IF

//------------------------------------------ Logica Pick & Place ------------------------------------------

// Solo se ejecuta si el sistema esta activo y no hay emergencia
IF sistemaActivo AND emergencia = FALSE THEN
    
    // Inicializacion de cintas si no hay piezas detectadas
    IF baseOK = FALSE AND tapaOK = FALSE THEN
        cintaBase := TRUE;
        cintaTapa := TRUE;
    END_IF
    
    // Deteccion de flancos de sensores
    flancoTapa(CLK := GVLvars.sensorFotoTapa);
    flancoBase(CLK := GVLvars.sensorFotoBase);
    
    // Base posicionada en barrera -> activar abrazadera
    IF flancoBase.Q THEN
        baseOK := TRUE;
        cintaBase := FALSE;
        GVLvars.cerrarAbrazaderaBase := TRUE;
    END_IF
    
    // Tapa posicionada en barrera -> activar abrazadera
    IF flancoTapa.Q THEN
        tapaOK := TRUE;
        cintaTapa := FALSE;
        GVLvars.cerrarAbrazaderaTapa := TRUE;
    END_IF
    
    //------------------------------------------
    // Maquina de estados Pick & Place
    //------------------------------------------
    CASE EstadoPickPlace OF

        // Estado 0: espera piezas y abrazaderas cerradas
        0:
            IF baseOK AND tapaOK AND GVLvars.limiteSujeccionBase AND GVLvars.limiteSujeccionTapa THEN
                EstadoPickPlace := 1;
            END_IF

        // Estado 1: desplazar horizontalmente
        1:
            GVLvars.PickPlace_MoverZ := FALSE; // vertical desactivado
            GVLvars.PickPlace_MoverX := TRUE;  // horizontal activado
            GVLvars.PickPlace_Agarrar := FALSE; // ventosa desactivada
            ProductoFinal := FALSE;
            comiezaProceso := TRUE;

            IF NOT GVLvars.PickPlace_MovingXY THEN
                timerMovimiento(IN := TRUE, PT := T#2S);
                IF timerMovimiento.Q THEN
                    timerMovimiento(IN := FALSE);
                    EstadoPickPlace := 2;
                END_IF
            END_IF

        // Estado 2: bajar verticalmente
        2:
            GVLvars.PickPlace_MoverZ := TRUE;
            GVLvars.PickPlace_MoverX := TRUE;
            GVLvars.PickPlace_Agarrar := FALSE;
            bajarSinObjeto := TRUE;

            IF NOT GVLvars.PickPlace_MovingZ THEN
                EstadoPickPlace := 3;
            END_IF

        // Estado 3: agarrar objeto
        3:
            GVLvars.PickPlace_MoverZ := TRUE;
            GVLvars.PickPlace_MoverX := TRUE;
            GVLvars.PickPlace_Agarrar := TRUE;

            timerMovimiento(IN := TRUE, PT := T#2S);
            IF timerMovimiento.Q THEN
                timerMovimiento(IN := FALSE);
                EstadoPickPlace := 4;
            END_IF

        // Estado 4: levantar verticalmente con objeto
        4:
            GVLvars.PickPlace_MoverZ := FALSE;
            GVLvars.PickPlace_MoverX := TRUE;
            GVLvars.PickPlace_Agarrar := TRUE;
            bajarSinObjeto := FALSE;

            IF NOT GVLvars.PickPlace_MovingZ THEN
                timerMovimiento(IN := TRUE, PT := T#2S);
                IF timerMovimiento.Q THEN
                    timerMovimiento(IN := FALSE);
                    EstadoPickPlace := 5;
                END_IF
                objetoSujeto := TRUE;
            END_IF

        // Estado 5: desplazar horizontal con objeto agarrado
        5:
            GVLvars.PickPlace_MoverZ := FALSE;
            GVLvars.PickPlace_MoverX := FALSE;
            GVLvars.PickPlace_Agarrar := TRUE;

            IF NOT GVLvars.PickPlace_MovingXY THEN
                timerMovimiento(IN := TRUE, PT := T#2S);
                IF timerMovimiento.Q THEN
                    timerMovimiento(IN := FALSE);
                    EstadoPickPlace := 6;
                END_IF
            END_IF

        // Estado 6: bajar vertical con objeto
        6:
            GVLvars.PickPlace_MoverZ := TRUE;
            GVLvars.PickPlace_MoverX := FALSE;
            GVLvars.PickPlace_Agarrar := TRUE;
            bajarConObjeto := TRUE;

            IF NOT GVLvars.PickPlace_MovingZ THEN
                timerMovimiento(IN := TRUE, PT := T#2S);
                IF timerMovimiento.Q THEN
                    timerMovimiento(IN := FALSE);
                    EstadoPickPlace := 7;
                END_IF
            END_IF

        // Estado 7: soltar objeto
        7:
            GVLvars.PickPlace_MoverZ := TRUE;
            GVLvars.PickPlace_MoverX := FALSE;
            GVLvars.PickPlace_Agarrar := FALSE;

            EstadoPickPlace := 8;
            objetoSujeto := FALSE;

        // Estado 8: regresar a posicion inicial
        8:
            GVLvars.PickPlace_MoverZ := FALSE;
            GVLvars.PickPlace_MoverX := FALSE;
            GVLvars.PickPlace_Agarrar := FALSE;
            comiezaProceso := TRUE;
            bajarConObjeto := FALSE;
            bajarSinObjeto := FALSE;

            IF NOT GVLvars.PickPlace_MovingZ THEN
                EstadoPickPlace := 9;
            END_IF

        // Estado 9: levantar abrazadera de tapa y preparar siguiente ciclo
        9:
            GVLvars.levantarAbrazaderaTapa := TRUE;
            cintaBase := FALSE;
            cintaTapa := TRUE;

            flancoPostSellado(CLK := GVLvars.sensorPostSellado);

            IF flancoPostSellado.Q THEN
                GVLvars.levantarAbrazaderaTapa := FALSE;
                baseOK := FALSE;
                tapaOK := FALSE;
                cintaBase := FALSE;
                cintaTapa := FALSE;
                GVLvars.cerrarAbrazaderaBase := FALSE;
                GVLvars.cerrarAbrazaderaTapa := FALSE;

                IF modoManual THEN
                    sistemaActivo := FALSE;
                END_IF

                EstadoPickPlace := 0;
            END_IF

    ELSE
        EstadoPickPlace := 0; // reiniciar si estado invalido
    END_CASE

ELSE
    // Sistema inactivo: detener cintas
    cintaTapa := FALSE;
    cintaBase := FALSE;
END_IF

//------------------------------------------ Actualizacion de salidas ------------------------------------------

GVLvars.cintaBases := cintaBase;
GVLvars.cintaTapas := cintaTapa;
GVLvars.luzVerticalNaranja := luzNaranja;
GVLvars.luzVerticalRoja := luzRojo;
GVLvars.luzVerticalVerde := luzVerde;
GVLvars.luzStop := luzStop;
GVLvars.luzStart := luzStart;
GVLvars.luzReset := luzReset;
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="1448" Count="253" />
      <LineId Id="410" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>