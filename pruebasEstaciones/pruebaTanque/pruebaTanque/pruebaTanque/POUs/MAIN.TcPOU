<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{4c6ab2c4-5e73-43da-80f3-e38131f4b388}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    //------------------------------------------
    // Botones y luces de cuadro
    //------------------------------------------
    luzBotonStart   : BOOL; // Indicador luminoso del boton Start
    luzBotonStop    : BOOL; // Indicador luminoso del boton Stop
    luzBotonReset   : BOOL; // Indicador luminoso del boton Reset
    
    luzVerde        : BOOL; // Luz verde de estado (sistema activo)
    luzAmarilla     : BOOL; // Luz amarilla de estado (parado)
    luzRoja         : BOOL; // Luz roja de estado (emergencia)

    //------------------------------------------
    // Control general del sistema
    //------------------------------------------
    Sistema_Activo  : BOOL; // Flag de enclavamiento del sistema
    emergencia      : BOOL; // Estado de emergencia
    parado          : BOOL; // Indica que se pulso stop
    modoManual      : BOOL; // Sistema en modo manual
    modoAuto        : BOOL; // Sistema en modo automatico
    primeraVez      : BOOL; // Primera vez que se ejecuta la secuencia
    Estado          : INT := 0; // Maquina de estados (0: espera, 1: descarga, 2: post-descarga, 3: cinta salida, 4: fin ciclo)
	arranqueCintaSalida : bool; // Arancar cintas despues de cargar si hay objeto cargado esperando
    //------------------------------------------
    // Temporizadores
    //------------------------------------------
    Timer_Llenado   : TON;  // Timer para el llenado del tanque
    Timer_Descarga  : TON;  // Timer de descarga
    InicioLLenado   : BOOL := TRUE; // Control de inicio de llenado
    cargandoTanque  : BOOL; // Indica que el tanque se esta llenando

    //------------------------------------------
    // Proceso de descargas y producto
    //------------------------------------------
    Sensor_Anterior : BOOL := FALSE; // Memoria sensor de salida (para detectar flanco)
    Flanco_Subida   : BOOL := FALSE; // Flanco de subida del sensor de salida
    numDescargas    : INT;           // Numero de descargas acumuladas
    vaciadosTotales : INT := 19;     // Numero total de descargas posibles
    salidaProducto  : BOOL;          // Indica si hay producto en salida (no se usa actualmente)

    //------------------------------------------
    // Calculos y mediciones
    //------------------------------------------
    porcentajeRestante : REAL; // Porcentaje restante de llenado o descarga
    calculoPorcentaje  : REAL; // Calculo intermedio de porcentaje
    tiempoLLenado      : TIME; // Tiempo estimado de llenado
    llenadoTotal       : BOOL; // Indica si el tanque esta lleno completamente
    tiempoCargaBarril  : TIME; // Tiempo de llenado de un barril (resultado de funcion, no usado)

	Cinta_Entrada: BOOL;
	Cinta_Tanque: BOOL;
	Cinta_Salida: BOOL;
	Discharge_Valve: BOOL;
	Fill_Valve: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//------------------------------------------ Logica Botones ------------------------------------------

// Reinicio de indicadores luminosos de los botones (solo se encienden cuando estan pulsados)
luzBotonStart := FALSE;
luzBotonStop := FALSE;
luzBotonReset := FALSE;

// Enclavamiento del boton Start: activa el sistema y enciende luz verde
IF GVLvars.Start_Button AND emergencia = FALSE THEN
    Sistema_Activo := TRUE;
    primeraVez := TRUE;
    luzVerde := TRUE;
    luzAmarilla := FALSE;
    luzRoja := FALSE;
    parado := FALSE;
    emergencia := FALSE;
    luzBotonStart := TRUE;
END_IF

// Boton Stop: apaga el sistema y enciende luz amarilla
IF NOT GVLvars.StopButton AND emergencia = FALSE THEN
    Sistema_Activo := FALSE;
    parado := TRUE;
    luzVerde := FALSE;
    luzAmarilla := TRUE;
    luzRoja := FALSE;
    InicioLLenado := FALSE;
    emergencia := FALSE;
    luzBotonStop := TRUE;
END_IF

// Seta de emergencia: apaga todo y enciende luz roja
IF GVLvars.seta = FALSE THEN
    Sistema_Activo := FALSE;
    parado := FALSE;
    luzVerde := FALSE;
    luzAmarilla := FALSE;
    luzRoja := TRUE;
    emergencia := TRUE;
END_IF

// Reset despues de emergencia: requiere pulsar boton Reset para volver a activar
IF GVLvars.seta AND emergencia THEN
    IF GVLvars.resetBoton THEN
        Sistema_Activo := TRUE;
        luzVerde := TRUE;
        luzAmarilla := FALSE;
        luzRoja := FALSE;
        parado := FALSE;
        emergencia := FALSE;
        luzBotonReset := TRUE;
    END_IF
END_IF

// Seleccion de modo Manual o Automatico
IF GVLvars.modoManual THEN
    modoManual := TRUE;
    modoAuto := FALSE;
END_IF

IF GVLvars.modoAuto THEN
    modoManual := FALSE;
    modoAuto := TRUE;
END_IF

//------------------------------------------ Calculo tiempos ------------------------------------------

// Definicion del tiempo de llenado segun sea la primera vez o no
// Primera vez: tanque vacio -> 39 segundos
// Resto de veces: tanque entre 20% y 80% -> 32 segundos
IF primeraVez THEN
    tiempoLLenado := T#39S;
ELSE 
    tiempoLLenado := T#32S;
    arranqueCintaSalida := TRUE; // marca para arrancar cintas tras el llenado
END_IF

// Control del llenado del tanque mediante temporizador
IF Sistema_Activo THEN
    Timer_Llenado(IN := InicioLLenado, PT := tiempoLLenado);

    // Mientras el temporizador esta corriendo -> llenar tanque
    IF NOT Timer_Llenado.Q AND InicioLLenado THEN
        Fill_Valve := TRUE;   // abrir valvula llenado
        cargandoTanque := TRUE;
    ELSE
        // Cuando el temporizador termina -> cerrar valvula
        Fill_Valve := FALSE;
        InicioLLenado := FALSE;
        cargandoTanque := FALSE;

        // Si estaba marcado arranque de cintas -> habilitarlas
        IF arranqueCintaSalida THEN
            Cinta_Tanque := TRUE;
            Cinta_Salida := TRUE;
            arranqueCintaSalida := FALSE;
        END_IF
    END_IF
END_IF

//------------------------------------------ Logica Tanque y Cintas ------------------------------------------

// Secuencia de maquina de estados para controlar cintas y descargas
IF Sistema_Activo AND InicioLLenado = FALSE AND emergencia = FALSE THEN
    
    // Primera vez: arranque inicial de las cintas
    IF primeraVez THEN
        Cinta_Entrada := TRUE;
        Cinta_Tanque := TRUE;
        Cinta_Salida := TRUE;
        primeraVez := FALSE;
    END_IF

    // Deteccion de flanco en sensor de salida del tanque
    Flanco_Subida := (NOT Sensor_Anterior) AND GVLvars.Sensor_Tanque_Salida;
    Sensor_Anterior := GVLvars.Sensor_Tanque_Salida;

    // Maquina de estados
    CASE Estado OF

        // Estado 0: esperando producto en entrada del tanque
        0:
            Cinta_Entrada := TRUE;
            Cinta_Tanque := TRUE;
            Cinta_Salida := TRUE;
            Discharge_Valve := FALSE;
            Timer_Descarga(IN := FALSE);

            // Si llega producto (flanco de sensor) -> pasar a descarga
            IF Flanco_Subida THEN
                Estado := 1;
            END_IF

        // Estado 1: descarga durante 2 segundos
        1:
            Cinta_Entrada := FALSE;
            Cinta_Tanque := FALSE;
            Cinta_Salida := FALSE;
            Discharge_Valve := TRUE;

            tiempoCargaBarril := CalculoTiempoLLenado(Volume_L :=709, Flow_Lps :=0.3543);

            Timer_Descarga(IN := TRUE, PT := T#2s);

            // Al terminar el tiempo de descarga -> contar y pasar a post-descarga
            IF Timer_Descarga.Q THEN
                Timer_Descarga(IN := FALSE);
                numDescargas := numDescargas + 1;
                Estado := 2;
            END_IF

        // Estado 2: post-descarga, reactivacion de cintas o reinicio de ciclo
        2:
            IF numDescargas < 16 THEN
                // Continuar ciclo normal
                Discharge_Valve := FALSE;
                Cinta_Entrada := TRUE;
                Cinta_Tanque := TRUE;
                Cinta_Salida := TRUE;
                Estado := 3;
            ELSE
                // Alcanzado limite de descargas -> parar y reiniciar llenado
                Discharge_Valve := FALSE;
                Cinta_Entrada := FALSE;
                Cinta_Tanque := FALSE;
                Cinta_Salida := FALSE;
                InicioLLenado := TRUE;
                numDescargas := 0;
                Estado := 3;
            END_IF

        // Estado 3: control de salida del producto
        3:
            IF GVLvars.sensorSalida THEN
                Cinta_Entrada := FALSE;
                Cinta_Tanque := FALSE;
                Cinta_Salida := FALSE;
                Estado := 4;
            END_IF

        // Estado 4: comprobacion modo de funcionamiemtno y retorno a estado inicial
        4:
            IF modoManual THEN
                Sistema_Activo := FALSE; // si esta en manual -> parar
            END_IF
            Estado := 0;

    END_CASE

ELSE
    // Sistema desactivado: parar todas las salidas y timers
    Cinta_Entrada := FALSE;
    Cinta_Tanque := FALSE;
    Cinta_Salida := FALSE;
    Timer_Descarga(IN := FALSE);
END_IF

//------------------------------------------ Actualizacion de salidas ------------------------------------------

// Asignacion de estados internos a las salidas del cuadro
GVLvars.luzAmarilla := luzAmarilla;
GVLvars.luzRoja := luzRoja;
GVLvars.luzVerde := luzVerde;
GVLvars.luzBotonReset := luzBotonReset;
GVLvars.luzBotonStart := luzBotonStart;
GVLvars.luzBotonStop := luzBotonStop;
GVLvars.Cinta_Entrada := Cinta_Entrada;
GVLvars.Cinta_Tanque := Cinta_Tanque;
GVLvars.Cinta_Salida := Cinta_Salida;
GVLvars.Discharge_Valve := Discharge_Valve;
 GVLvars.Fill_Valve := Fill_Valve;

]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="2173" Count="206" />
      <LineId Id="2382" Count="0" />
      <LineId Id="2381" Count="0" />
      <LineId Id="2385" Count="0" />
      <LineId Id="2388" Count="0" />
      <LineId Id="2387" Count="0" />
      <LineId Id="104" Count="0" />
    </LineIds>
